{
  // The Worker and its Durable Objects, typed against the Workers runtime. The protocol module is typechecked here as
  // the Worker imports it and again, alone, by tsconfig.protocol.json; the tests by tsconfig.test.json, except the
  // workerd entry and Node suites importing Worker objects/storage, which need the Worker types here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "isolatedModules": true,
    // The protocol package (apps/org-protocol) imports with `.ts` extensions, so Node loads it unbundled.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/support/worker-under-test.ts", "test/support/send-fault.ts", "test/machine-end.test.ts", "test/op-store.test.ts", "test/org-chain.test.ts"]
}
