{
  // The Worker and its Durable Objects, typed against the Workers runtime. The protocol module is typechecked here as
  // the Worker imports it and again, alone, by tsconfig.protocol.json; the tests by tsconfig.test.json, but for the
  // Worker entry the suites load, which runs in workerd, and the one suite that runs a Worker object under Node, which
  // are typed here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/support/worker-under-test.ts", "test/support/send-fault.ts", "test/machine-end.test.ts"]
}
