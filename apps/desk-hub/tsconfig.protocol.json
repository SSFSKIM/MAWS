{
  // The protocol module alone, against the protocol package's types/neutral-runtime.d.ts and no runtime's types: it is
  // imported by the Worker, the web app (DC5), and the fake machine, and imports the package (apps/org-protocol), so a
  // Workers, Node, or DOM API either reaches for fails to compile here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "include": ["src/protocol/**/*.ts", "../org-protocol/types/neutral-runtime.d.ts"]
}
