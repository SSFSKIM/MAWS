{
  // The web app, typed against the browser: no Node, no Electron, no `window.maws`. The protocol module comes in through
  // `desk-hub/protocol` and is checked here as the app imports it. Its configs, the tests, the double, and the browser
  // suites are tsconfig.node.json's.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // MAWS's renderer modules the desk imports as they stand (the renderer survey) name src/shared as `@shared`.
    "paths": { "@shared/*": ["../../src/shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
