{
  // What runs under Node: the build and test configs, the unit suites (which also reach the app's modules), the DX3
  // protocol double, and the browser suites that drive it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  // P5 O13 M7: MAWS's staging phone run (its live suite and pieces under test/endpoint), which drives this app's cards
  // client and device code over the endpoint as test/local/endpoint.ts does; MAWS's own tsconfig leaves it to this one.
  "include": ["*.config.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "e2e/**/*.ts", "e2e-hub/**/*.ts", "../../src/renderer/src/env.d.ts", "../../test/endpoint/staging/**/*.ts", "../../test/endpoint/staging-phone.live.test.ts"],
  "exclude": []
}
