{
  "name": "maws",
  "productName": "MAWS",
  "version": "0.0.0",
  "private": true,
  "description": "A macOS workstation for supervising Claude Code agent sessions",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:stub": "node scripts/dev-stub.js",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.e2e.json --composite false",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:live": "MAWS_LIVE=1 vitest run --project live --silent=false",
    "e2e": "playwright test",
    "e2e:packaged": "MAWS_E2E_EXECUTABLE=${MAWS_E2E_EXECUTABLE:-dist/mac-arm64/MAWS.app/Contents/MacOS/MAWS} playwright test",
    "build:app": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e && pnpm build:app && pnpm e2e:packaged && pnpm e2e:transcript && pnpm e2e:terminal && pnpm e2e:panel && pnpm e2e:code",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "dev:harness": "MAWS_HARNESS=1 electron-vite dev",
    "e2e:transcript": "MAWS_HARNESS=1 electron-vite build && MAWS_HARNESS=1 playwright test e2e/transcript.spec.ts",
    "e2e:terminal": "MAWS_HARNESS=1 electron-vite build && MAWS_HARNESS=1 playwright test e2e/terminal.spec.ts",
    "e2e:panel": "MAWS_HARNESS=1 electron-vite build && MAWS_HARNESS=1 playwright test e2e/panel.spec.ts",
    "e2e:code": "MAWS_HARNESS=1 electron-vite build && MAWS_HARNESS=1 playwright test e2e/code-tools.spec.ts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper && install-electron"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@git-diff-view/core": "0.1.7",
    "@git-diff-view/react": "0.1.7",
    "@git-diff-view/shiki": "0.1.7",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/headless": "6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cmdk": "^1.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20",
    "katex": "^0.16.47",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-harden": "^1.1.8",
    "shiki": "^3.19.0",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
