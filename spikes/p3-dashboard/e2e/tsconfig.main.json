{
  // The spike's Electron main imports MAWS's main-process modules, typechecked as tsconfig.node.json checks them (no DOM).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": { "@shared/*": ["../../../src/shared/*"], "@artifacts/*": ["../../../src/artifacts/*"] }
  },
  "include": ["main.ts"]
}
