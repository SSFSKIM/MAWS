{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@shared/*": [
        "../../src/shared/*"
      ],
      "@artifacts/*": [
        "../../src/artifacts/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "e2e/main.ts"
  ]
}
