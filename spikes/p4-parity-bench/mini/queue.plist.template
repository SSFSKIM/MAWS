<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The parity bench's queue runner as a one-shot LaunchAgent in the console's login session (findings.txt §7a),
     rendered by bench-queue.sh into the run's queue directory and bootstrapped into gui/<uid>; never installed in
     ~/Library/LaunchAgents. Interactive, so launchd applies no background throttling to the repetitions it runs. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>@RUNNER@</string><string>@QUEUE@</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Interactive</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>@QUEUE@/runner.out</string>
  <key>StandardErrorPath</key><string>@QUEUE@/runner.err</string>
</dict>
</plist>
