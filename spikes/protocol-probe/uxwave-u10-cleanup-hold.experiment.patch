+    if (!doc.__pwHeld) { doc.__pwHeld = doc.cleanupFormatting; doc.cleanupFormatting = false; doc.once('afterAllTransactions', () => { doc.cleanupFormatting = doc.__pwHeld; doc.__pwHeld = undefined; }); }
+    return run();
+  }
+  const was = doc.cleanupFormatting;
+  doc.cleanupFormatting = false;
+  try { run(); } finally { doc.cleanupFormatting = was; }
+}
+// --- end EXPERIMENT ---
 
