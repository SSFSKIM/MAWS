+const cleanupOpen = new WeakSet<object>();
+(Y.Doc.prototype as any).emit = function (this: any, name: string, args: any[]) {
+  if (AUDIT && name === 'beforeTransaction' && (new Error().stack ?? '').includes('cleanupYTextAfterTransaction')) cleanupOpen.add(args[0]);
+  if (AUDIT && name === 'afterTransaction' && cleanupOpen.has(args[0])) {
+    let deleted = 0;
+    args[0].deleteSet.clients.forEach((r: any) => r.getIds().forEach((x: any) => (deleted += x.len)));
