{
  "$description": "Classroom: white paper and dark ink that survive the copier and the lecture-room projector, in a humanist sans whose l, I and 1 never collide; one solid cobalt tab marks the part of the work the room is on.",
  "$extensions": {
    "dev.maws.office": {
      "fonts": {
        "major": { "ea": "Malgun Gothic", "latin": "Trebuchet MS" },
        "minor": { "ea": "Malgun Gothic", "latin": "Trebuchet MS" }
      }
    },
    "dev.maws.page": { "margin": { "unit": "px", "value": 72 }, "size": "letter" }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
      },
      "raised": {
        "$value": { "colorSpace": "srgb", "components": [0.949, 0.9608, 0.9765], "hex": "#f2f5f9" }
      }
    },
    "text": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [0.0824, 0.0941, 0.1137], "hex": "#15181d" }
      },
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.2941, 0.3255, 0.3804], "hex": "#4b5361" },
        "$description": "Held at 7.8 : 1 so it survives a projector in a lit room."
      }
    },
    "accent": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [0.1412, 0.3255, 0.7882], "hex": "#2453c9" },
        "$description": "Fills the part tab and nothing else: the only filled colour on a page."
      },
      "text": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
      }
    },
    "border": {
      "$value": { "colorSpace": "srgb", "components": [0.5412, 0.5804, 0.6392], "hex": "#8a94a3" },
      "$description": "Write-in boxes and rules; 3.1 : 1, because a box to write in is a control."
    },
    "status": {
      "ok": {
        "$value": { "colorSpace": "srgb", "components": [0.0941, 0.502, 0.2902], "hex": "#18804a" }
      },
      "warn": {
        "$value": { "colorSpace": "srgb", "components": [0.6392, 0.3529, 0], "hex": "#a35a00" }
      },
      "error": {
        "$value": { "colorSpace": "srgb", "components": [0.7843, 0.1961, 0.1686], "hex": "#c8322b" }
      },
      "info": {
        "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4549, 0.5333], "hex": "#0f7488" }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Seravek", "Apple SD Gothic Neo", "Trebuchet MS", "Malgun Gothic", "sans-serif"]
    },
    "body": {
      "$value": ["Seravek", "Apple SD Gothic Neo", "Trebuchet MS", "Malgun Gothic", "sans-serif"]
    },
    "mono": {
      "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"]
    }
  },
  "type": {
    "$type": "typography",
    "title": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 30, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.25,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 112 }, "lineHeight": 1.15 } }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 17, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.45,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 52 }, "lineHeight": 1.3 } }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 23, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 80 }, "lineHeight": 1.2 } }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 19, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.35,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 64 }, "lineHeight": 1.25 } }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.45,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 52 }, "lineHeight": 1.3 } }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.65,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 48 }, "lineHeight": 1.4 } }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.45,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 36 }, "lineHeight": 1.4 } }
    },
    "quote": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 17, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 56 }, "lineHeight": 1.35 } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": { "value": 4, "unit": "px" }
    },
    "2": {
      "$value": { "value": 8, "unit": "px" }
    },
    "3": {
      "$value": { "value": 12, "unit": "px" }
    },
    "4": {
      "$value": { "value": 20, "unit": "px" }
    },
    "5": {
      "$value": { "value": 28, "unit": "px" }
    },
    "6": {
      "$value": { "value": 40, "unit": "px" }
    },
    "7": {
      "$value": { "value": 56, "unit": "px" }
    },
    "8": {
      "$value": { "value": 80, "unit": "px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": { "value": 4, "unit": "px" }
    },
    "md": {
      "$value": { "value": 8, "unit": "px" }
    },
    "lg": {
      "$value": { "value": 12, "unit": "px" }
    },
    "full": {
      "$value": { "value": 9999, "unit": "px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0.0824, 0.0941, 0.1137], "alpha": 0.08, "hex": "#15181d" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0.0824, 0.0941, 0.1137], "alpha": 0.06, "hex": "#15181d" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 4, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0.0824, 0.0941, 0.1137], "alpha": 0.08, "hex": "#15181d" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 20, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0.0824, 0.0941, 0.1137], "alpha": 0.08, "hex": "#15181d" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 8, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0.0824, 0.0941, 0.1137], "alpha": 0.14, "hex": "#15181d" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 24, "unit": "px" },
          "blur": { "value": 56, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    }
  }
}
