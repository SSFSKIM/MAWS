{
  "$description": "MAWS, the house system: the app’s warm ground and white sheet carried into documents and decks; terracotta marks the reader’s one action. Adopted from MAWS’s app tokens.",
  "$extensions": {
    "dev.maws.office": {
      "fonts": {
        "major": { "ea": "Malgun Gothic", "latin": "Segoe UI" },
        "minor": { "ea": "Malgun Gothic", "latin": "Segoe UI" }
      }
    },
    "dev.maws.page": { "margin": { "unit": "px", "value": 72 }, "size": "letter" }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [0.9804, 0.9765, 0.9647], "hex": "#faf9f6" }
      },
      "raised": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
      }
    },
    "text": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [0.1216, 0.1176, 0.1059], "hex": "#1f1e1b" }
      },
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.4471, 0.4431, 0.4314], "hex": "#72716e" },
        "$description": "The ink at 62 % flattened onto the ground; 4.6 : 1 on bg."
      }
    },
    "accent": {
      "$root": {
        "$value": { "colorSpace": "srgb", "components": [0.7882, 0.4, 0.2471], "hex": "#c9663f" },
        "$description": "The reader’s one action, and nothing else. 3.7 : 1 on bg: large text and marks only."
      },
      "text": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
        "$description": "Text on an accent ground; 3.9 : 1, so large or bold ≥ 19 px only."
      }
    },
    "border": {
      "$value": { "colorSpace": "srgb", "components": [0.8902, 0.8863, 0.8745], "hex": "#e3e2df" },
      "$description": "Hairlines only; never a control’s edge."
    },
    "status": {
      "ok": {
        "$value": { "colorSpace": "srgb", "components": [0.1216, 0.5608, 0.3333], "hex": "#1f8f55" }
      },
      "warn": {
        "$value": { "colorSpace": "srgb", "components": [0.7216, 0.4157, 0.102], "hex": "#b86a1a" }
      },
      "error": {
        "$value": { "colorSpace": "srgb", "components": [0.7882, 0.2314, 0.2314], "hex": "#c93b3b" }
      },
      "info": {
        "$value": { "colorSpace": "srgb", "components": [0.2314, 0.4353, 0.8196], "hex": "#3b6fd1" }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["SF Pro Display", "Apple SD Gothic Neo", "-apple-system", "Segoe UI", "Malgun Gothic", "sans-serif"]
    },
    "body": {
      "$value": ["SF Pro Text", "Apple SD Gothic Neo", "-apple-system", "Segoe UI", "Malgun Gothic", "sans-serif"]
    },
    "mono": {
      "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"]
    }
  },
  "type": {
    "$type": "typography",
    "title": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 34, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 96 }, "lineHeight": 1.2 } }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 19, "unit": "px" },
        "fontWeight": 500,
        "lineHeight": 1.55,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 44 }, "lineHeight": 1.4 } }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 26, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.35,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 72 }, "lineHeight": 1.25 } }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 21, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.45,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 56 }, "lineHeight": 1.3 } }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 17, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.55,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 44 }, "lineHeight": 1.35 } }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.7,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 40 }, "lineHeight": 1.5 } }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 28 }, "lineHeight": 1.45 } }
    },
    "quote": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 17, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.75,
        "letterSpacing": { "value": 0, "unit": "px" }
      },
      "$extensions": { "dev.maws.deck": { "fontSize": { "unit": "px", "value": 48 }, "lineHeight": 1.45 } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": { "value": 4, "unit": "px" }
    },
    "2": {
      "$value": { "value": 8, "unit": "px" }
    },
    "3": {
      "$value": { "value": 12, "unit": "px" }
    },
    "4": {
      "$value": { "value": 16, "unit": "px" }
    },
    "5": {
      "$value": { "value": 24, "unit": "px" }
    },
    "6": {
      "$value": { "value": 32, "unit": "px" }
    },
    "7": {
      "$value": { "value": 48, "unit": "px" }
    },
    "8": {
      "$value": { "value": 64, "unit": "px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": { "value": 6, "unit": "px" }
    },
    "md": {
      "$value": { "value": 10, "unit": "px" }
    },
    "lg": {
      "$value": { "value": 14, "unit": "px" }
    },
    "full": {
      "$value": { "value": 9999, "unit": "px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.04, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 0, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "spread": { "value": 1, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 6, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.04, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 0, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "spread": { "value": 1, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.04, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 8, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.024, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 80, "unit": "px" },
          "spread": { "value": 8, "unit": "px" }
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.04, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 0, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "spread": { "value": 1, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 24, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 24, "unit": "px" },
          "blur": { "value": 64, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    }
  }
}
