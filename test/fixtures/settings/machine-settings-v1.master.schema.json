{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "binaryPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "subagentModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "memoryBudgetMiB": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 512,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "statefulMcpServers": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "memoryBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "mcpServers": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "type": {
                "type": "string",
                "const": "http"
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "name",
              "type",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "launchProfile": {
          "type": "object",
          "properties": {
            "plugins": {
              "type": "object",
              "properties": {
                "off": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[^\\s@]+@[^\\s@]+$"
                  }
                }
              },
              "required": [
                "off"
              ],
              "additionalProperties": false
            },
            "hooks": {
              "type": "string",
              "enum": [
                "user",
                "none"
              ]
            }
          },
          "required": [
            "plugins",
            "hooks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "binaryPath",
        "subagentModel",
        "memoryBudgetMiB",
        "statefulMcpServers",
        "memoryBudget",
        "mcpServers",
        "launchProfile"
      ],
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "defaultRoute": {
          "type": "string",
          "enum": [
            "gateway",
            "direct"
          ]
        },
        "relayUnreachable": {
          "type": "string",
          "enum": [
            "ask",
            "wait",
            "direct"
          ]
        },
        "offerDirect": {
          "type": "boolean"
        }
      },
      "required": [
        "defaultRoute",
        "relayUnreachable",
        "offerDirect"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "autoFallback": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "bypassPermissions",
            "dontAsk"
          ]
        }
      },
      "required": [
        "autoFallback"
      ],
      "additionalProperties": false
    },
    "mods": {
      "type": "object",
      "properties": {
        "toHuman": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "toHuman"
      ],
      "additionalProperties": false
    },
    "supervisor": {
      "type": "object",
      "properties": {
        "idleExitMinutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "idleExitMinutes"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "defaultDesignSystem": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "spaceDesignSystems": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "additionalProperties": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        }
      },
      "required": [
        "defaultDesignSystem",
        "spaceDesignSystems"
      ],
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "properties": {
        "archiveInactiveDays": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number",
                  "const": 7
                },
                {
                  "type": "number",
                  "const": 14
                },
                {
                  "type": "number",
                  "const": 30
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "archiveInactiveDays"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "engine",
    "gateway",
    "permissions",
    "mods",
    "supervisor",
    "artifacts",
    "sessions"
  ],
  "additionalProperties": false
}
