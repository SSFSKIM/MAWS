{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/engine-host/**/*",
    "src/pty-host/**/*",
    "src/shared/**/*",
    "test/**/*",
    // C8a start: test/support/panel-child-fixture.ts measures its fixture through C6's pure model (createState,
    // applyEvents, rowsOf) and journalToEvents; vitest's typecheck runs this project composite, which refuses a file
    // the include does not list
    "src/renderer/src/transcript/model/*.ts",
    "src/renderer/src/transcript/dev/journal.ts",
    // C8a end
    // C8b start: test/support/agents-fixtures.test.ts checks the derived fixtures' tails through the agent tools' pure
    // models (applyTaskEvents, matchesSendMessage, phasesOf) and their copy; listed for the same reason as C8a's
    "src/renderer/src/tools/agents/model/*.ts",
    "src/renderer/src/tools/agents/copy.ts"
    // C8b end
  ]
}
