{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/engine-host/**/*",
    "src/pty-host/**/*",
    "src/shared/**/*",
    "test/**/*",
    // C8a start: test/support/panel-child-fixture.ts measures its fixture through C6's pure model (createState,
    // applyEvents, rowsOf) and journalToEvents; vitest's typecheck runs this project composite, which refuses a file
    // the include does not list
    "src/renderer/src/transcript/model/*.ts",
    "src/renderer/src/transcript/dev/journal.ts"
    // C8a end
  ]
}
