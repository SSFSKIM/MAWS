{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/engine-host/**/*",
    "src/pty-host/**/*",
    "src/shared/**/*",
    "src/artifacts/**/*", // P3-A: the portable artifact layer, typechecked as the host will import it
    "test/**/*",
    // C8a start: test/support/panel-child-fixture.ts measures its fixture through C6's pure model (createState,
    // applyEvents, rowsOf) and journalToEvents; the project is composite (tsconfig.base.json), which refuses a file the
    // include does not list
    "src/renderer/src/transcript/model/*.ts",
    "src/renderer/src/transcript/dev/journal.ts",
    // C8a end
    // C8b start: test/support/agents-fixtures.test.ts checks the derived fixtures' tails through the agent tools' pure
    // models (applyTaskEvents, matchesSendMessage, phasesOf) and their copy; listed for the same reason as C8a's
    "src/renderer/src/tools/agents/model/*.ts",
    "src/renderer/src/tools/agents/copy.ts",
    // C8b end
    // E3 start: the transcript model's export words the side-thread row through E3's copy, which takes the composer's
    // own "next step" wording; listed for the same reason as C8a's
    "src/renderer/src/side/copy.ts",
    "src/renderer/src/composer/submit/submit-state.ts",
    // E3 end
    // E11 start: test/support/processes.test.ts runs the supervisor specs' process cleanup under vitest,
    // test/support/scratch-env.test.ts the e2e launches' environments, and test/support/p1-live.test.ts the live
    // sittings' pure parts and the OOPIF page (Task 6.1)
    "e2e/support/processes.ts",
    "e2e/support/scratch-env.ts",
    "e2e/support/p1-live.ts",
    "e2e/support/oopif-page.ts",
    // E11 end
    // P2-F: test/support/live-budget.test.ts runs the live specs' engine cap
    "e2e/support/live-budget.ts",
    // P2-F F-E: test/support/live-turns.test.ts runs the live specs' wait for a submitted turn
    "e2e/support/live-turns.ts",
    // P3-C M9: test/support/text-run.test.ts runs the LibreOffice compare's text matcher
    "e2e/support/text-run.ts",
    // P3-C M10: test/support/live-lifecycle.test.ts runs the live runs' end (the stop, the cleanup, the engine's survival, the spend)
    "e2e/support/live-lifecycle.ts",
    // P3-E1 M6: test/support/design-bundle.test.ts runs the Design final run's bundle checks
    "e2e/support/design-bundle.ts",
    "e2e/support/design-final-reporter.ts", // P3-E1 M6: test/support/design-final-reporter.test.ts drives it at its boundary
    "e2e/support/design-geometry.ts", // P3-E1 M6: test/support/design-geometry.test.ts runs the evidence probe's hidden-node rule
    // P3-E1 M6: test/support/design-frames.test.ts runs the design scale gate's frame readings
    "e2e/support/design-frames.ts",
    // P3-H: test/support/final-bundle.test.ts runs the final run's build bundle and its reporter (gate-offload Decision Log 50)
    "e2e/support/final-bundle.ts",
    "e2e/support/final-bundle-reporter.ts",
    // P3-H: test/support/send-to-approval.test.ts runs the Send to live run's approval predicate
    "e2e/support/send-to-approval.ts",
    // P3-HD M4a: test/support/connector-oauth*.test.ts run the toy OAuth fixture's logic, its scene support and fake browser
    "e2e/support/connector-oauth-core.d.mts",
    "e2e/support/connector-oauth.ts",
    "e2e/support/connector-oauth-browser.ts",
    // P2-F S-locale: the transcript model's day words and the agent tools' ages write through the renderer's date
    // formats (D2 widened), and the agent models' tests read the system locale's relative times; listed for the same
    // reason as C8a's
    "src/renderer/src/app/date-format.ts",
    "src/renderer/src/test-support/relative-time.ts",
    "src/renderer/src/artifacts/host.ts", // P3-A M5: the detached-channel test drives the real ArtifactHost under Node
    "src/renderer/src/artifacts/command-error.ts", // P3-H H4: host.ts's error, shared with its connector family
    "src/renderer/src/artifacts/connectors.ts", // P3-H H4: host.ts's connector family
    // P3-B: test/artifacts/document-writer-bench.test.ts benches the patch writer on the 200-page seed M9's gate uses
    "e2e/support/document-seed.ts",
    // P3-E (E2 M6): test/support/dashboard-bundle.test.ts runs the dashboard acceptance run's final bundle checks
    "e2e/support/dashboard-bundle.ts",
    "e2e/support/dashboard-acceptance.ts",
    "e2e/support/dashboard-scale.ts" // P3-E (E2 M6): test/support/dashboard-scale.test.ts runs the scale gate's judging
  ],
  // P3-B: the document editor's React and DOM, and the importers that parse HTML through the DOM (M6), typechecked by
  // tsconfig.web.json. P3-D M4: the design system's React and DOM (the apply API's scopes, the page), likewise. P3-C M4:
  // the slide canvas and the deck editor, likewise (M9: `canvas/css.ts` stays in, since the exporters in main write it).
  "exclude": [
    "src/main/artifacts/*.dom.test.tsx",
    "src/artifacts/document/editor/**/*",
    "src/artifacts/document/import/html*",
    "src/artifacts/document/import/docx*",
    "src/artifacts/design-system/apply.ts", // P3-D
    "src/artifacts/design-system/scope-style.ts", // P3-D
    "src/artifacts/design-system/page/**/*", // P3-D
    "src/artifacts/design-system/**/*.test.tsx", // P3-D
    "src/artifacts/slides/canvas/slide-canvas.ts", // P3-C
    "src/artifacts/slides/canvas/elements.ts", // P3-C
    "src/artifacts/slides/canvas/fit.ts", // P3-C
    "src/artifacts/slides/canvas/index.ts", // P3-C
    "src/artifacts/slides/editor/**/*", // P3-C
    "src/artifacts/design/editor/**/*.tsx", // P3-E1 M3: the workbench's React and DOM (its pure modules beside them stay in)
    "src/artifacts/**/*.dom.test.tsx", // P3-C
    "src/artifacts/dashboard/editor/**/*" // P3-E (E2 M3): the dashboard's node views and source sheet, typechecked by tsconfig.web.json
  ]
}
